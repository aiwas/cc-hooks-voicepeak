#!/usr/bin/env bash
# cc-voicepeak のランチャ.
#
# Claude Code の hooks からは絶対パスで呼ばれるため、リポジトリを
# clone しただけで動くように PYTHONPATH を自前で通している。
# 例: .claude/settings.json で
#   "command": "$CLAUDE_PROJECT_DIR/bin/cc-voicepeak hook"
set -uo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname -- "$here")"

python_bin="${CC_VOICEPEAK_PYTHON:-}"
if [ -z "$python_bin" ]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      python_bin="$candidate"
      break
    fi
  done
fi

if [ -z "$python_bin" ]; then
  echo "cc-voicepeak: python3 が見つかりません" >&2
  # hook を失敗させて Claude Code を止めたくないので 0 で抜ける
  exit 0
fi

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"
exec "$python_bin" -m cc_voicepeak "$@"
